# ──────────── AtzvaVote (הצבעת אצווה) - הגדרות שרת ────────────
# פורטים שונים ממונדיאל 2026 כדי ששתי המערכות ירוצו על אותו שרת:
# מונדיאל: שרת 5222 / לקוח 5225 · AtzvaVote: שרת 5232 / לקוח 5235
PORT=5232

# ──────────── JWT ────────────
JWT_SECRET=atzvavote-secret-change-me-in-production

# ──────────── מנהל ראשוני ────────────
# נוצר בהרצה הראשונה של 'npm run db:seed'
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=changeme123

# ──────────── MySQL 8 ────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atzvavote

# אופציונלי - אם מוגדר, נשתמש ב-Unix socket במקום TCP (מהיר יותר על שרת יחיד)
# דוגמאות: /var/run/mysqld/mysqld.sock (Ubuntu/Debian) | /tmp/mysql.sock (macOS)
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ──────────── קטלוג המוצרים (רמה 2 - דירוג חיצוני) ────────────
# ה-API של seach-data-api. אין CORS בצד ההוא — השרת שלנו עושה פרוקסי ומטמון מקומי.
SEACH_API_URL=https://seach-api.hinbit.com
SEACH_API_KEY=

# ──────────── כתובת האתר ────────────
SITE_URL=https://atzvavote.canabolabs.com

# ──────────── שליחת אימיילים ────────────
# כל ההגדרות האלה ניתנות לעריכה גם מפאנל הניהול → הגדרות (נשמרות בטבלת settings).
# ערכי ה-env כאן משמשים רק כברירת מחדל בהרצת 'npm run db:seed'.
#
# ספק השליחה למשתמשים: smtp (ברירת מחדל) או gmail (חשבון Gmail עם סיסמת אפליקציה)
EMAIL_USER_DELIVERY_MODE=smtp
# שליחת תוצאות למשתמשים (ברירת מחדל כבוי), שעת שליחה ומי מקבל
SEND_RESULTS_TO_USERS=0
SEND_RESULTS_HOUR=19
SEND_RESULTS_AUDIENCE=all
# SMTP של הספק (דוח המנהלת תמיד נשלח דרכו)
SMTP_SERVER=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_MANAGER_EMAIL=
# חשבון Gmail (כש-EMAIL_USER_DELIVERY_MODE=gmail) — נשלח דרך smtp.gmail.com.
GMAIL_APP_USER=
GMAIL_APP_PASSWORD=

# ──────────── ערכת נושא (Theme) ────────────
# בוחר את ערכת המיתוג הפעילה מתוך resources/themes/{name}
# אפשרויות: atzvavote (ברירת מחדל) | seach | 4pharma | friends | hinbit
THEME=atzvavote

# ──────────── פיצ'רים ────────────
SITE_GUESS_GROUPS_ENABLED=false
SITE_PRODUCTS_ENABLED=true
SITE_BATTLES_ENABLED=true

# ──────────── יצירת תמונות נושא (אופציונלי) ────────────
# משמש רק את הסקריפט resources/themes/generate-images.mjs ליצירת נכסי ערכות נושא חדשות
DEFAULT_IMAGE_ENGINE=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash
